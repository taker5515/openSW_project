# Database
DATABASE_URL=sqlite:///./stockdb.sqlite3
# PostgreSQL: postgresql://user:password@localhost:5432/stockdb

# JWT
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Analysis (optional)
# Anthropic API key for real AI news analysis.
# If empty, heuristic fallback is used automatically.
ANTHROPIC_API_KEY=

# Mock mode (set true for local dev without external APIs)
USE_MOCK_DATA=false

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Email (optional — stub logs if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
